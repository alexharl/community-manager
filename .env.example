# --- Backend ---------------------------------------------------------------
PORT=3000
DATABASE_URL=postgres://cm:cm@localhost:5433/cm
# Relative Pfade beziehen sich auf das Verzeichnis dieser Datei
DATA_DIR=./data
# 32 Byte, base64. Erzeugen mit:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET=

# --- ONLYOFFICE --------------------------------------------------------------
# Browser -> Document Server
ONLYOFFICE_PUBLIC_URL=http://localhost:8090
# Backend -> Document Server
ONLYOFFICE_INTERNAL_URL=http://localhost:8090
# Gemeinsames Secret von Backend und Document Server (mind. 16 Zeichen)
ONLYOFFICE_JWT_SECRET=
# Document Server -> Backend (aus Sicht des Containers)
BACKEND_URL_FOR_ONLYOFFICE=http://host.docker.internal:3000

# --- Docker Compose ----------------------------------------------------------
POSTGRES_DB=cm
POSTGRES_USER=cm
POSTGRES_PASSWORD=cm
DB_PORT=5433
ONLYOFFICE_PORT=8090
# Nur Entwicklung (Mailpit)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
